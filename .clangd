CompileFlags:
  Add: ["-Wall", "-Wextra", "-Wno-xor-used-as-pow", "-DCPLIB_CLANGD=1"]

Diagnostics:
  UnusedIncludes: Strict
  MissingIncludes: Strict

---
If:
  PathMatch: .*\.20\.(cpp|hpp)$
CompileFlags:
  Add: ["-xc++", "-std=c++20"]

---
If:
  PathMatch: .*\.23\.(cpp|hpp)$
CompileFlags:
  Add: ["-xc++", "-std=c++23"]
